# The console reaches the orchestrator on the compose network with the service token
# (TRD §3.4). Never put the token in a browser bundle: only server code reads it.
ORCHESTRATOR_URL=http://127.0.0.1:8000
FACTORY_SERVICE_TOKEN=

# Sign-in (unit 57): the factory GitHub App's user authorisation (OAuth) and the console's own
# session store. Generate the two keys with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
CONSOLE_SESSION_KEY=
CONSOLE_DB_PATH=console.db
